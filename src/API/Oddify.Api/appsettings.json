{
  "ConnectionStrings": {
    "Database": "",
    "Cache": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 0
  },
  "OutboxProcessor": {
    "Enabled": true,
    "Interval": "00:00:10",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetentionPeriod": "7.00:00:00",
    "CleanupInterval": "1.00:00:00"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Oddify.Api"
    }
  }
}
