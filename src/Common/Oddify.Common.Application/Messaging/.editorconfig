# ICommandsScheduler.cs é escrito deliberadamente no estilo estrutural do projeto de referência
# Modular Monolith with DDD (Kamil Grzybek) — namespace em bloco, não file-scoped. Os demais
# arquivos desta pasta (ICommand.cs, IQuery.cs, ...) continuam sob a regra global (:error) do
# .editorconfig raiz.
[ICommandsScheduler.cs]
csharp_style_namespace_declarations = block_scoped:none
