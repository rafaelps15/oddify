# Toda esta pasta é o subsistema ICommandsScheduler/InternalCommand, escrito deliberadamente no
# estilo estrutural do projeto de referência Modular Monolith with DDD (Kamil Grzybek) — namespace
# em bloco, não file-scoped como no resto do repo (regra global :error no .editorconfig raiz).
[*.cs]
csharp_style_namespace_declarations = block_scoped:none

# CA1852/S3260 (seal internal types) conflitam com o estilo deliberadamente não-sealed desta pasta.
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.S3260.severity = none
